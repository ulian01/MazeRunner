// servo and ultrasonic variables

volatile bool scanningActive = false;
int headState = 0;
unsigned long headStateStart = 0;
float currentDistance = 0;
bool isGlancing = false;

unsigned long segmentStartTime = 0;
bool justTurned = false;
bool drivingIntoOpening = false;
unsigned long lastGripperPulse = 0;

// Stuck detection
unsigned long lastStuckCheck = 0;
float lastStuckDist = 0;
int stuckCounter = 0;

#define MAX_PATH 200
char path[MAX_PATH];
int pathIndex = 0;

enum RobotState { MOVING_FORWARD, TURNING_LEFT, TURNING_RIGHT, BACKING_UP, ENTERING_OPENING };
RobotState currentState = MOVING_FORWARD;
unsigned long actionStartTime = 0;
unsigned long actionDuration  = 0;

enum Mode { START_SEQ, MAZE_NAV, LINE_FOLLOW, DONE };
Mode currentMode = START_SEQ;
void setup() {
  pinMode(LEFT_FWD, OUTPUT);
  pinMode(LEFT_BWD, OUTPUT);
  pinMode(RIGHT_FWD, OUTPUT);
  pinMode(RIGHT_BWD, OUTPUT);
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);
  pinMode(SERVO_PIN, OUTPUT);
  pinMode(GRIPPER, OUTPUT);
  digitalWrite(GRIPPER, 1); 
  digitalWrite(GRIPPER, 0);

  pinMode(LEFT_BWD, OUTPUT);
  pinMode(LEFT_FWD, OUTPUT);
  pinMode(RIGHT_BWD, OUTPUT);
  pinMode(RIGHT_FWD, OUTPUT);


  Serial.begin(9600);
  delay(50);
  Serial.println("ROBOT_READY");
  
  servoWrite(70);
  stopMotors();
  segmentStartTime = millis();

  // Send multiple pulses to ensure gripper opens
for (int i = 0; i < 50; i++) {
  digitalWrite(GRIPPER, HIGH);
  delayMicroseconds(GRIPPER_OPEN);
  digitalWrite(GRIPPER, LOW);
  delay(20);
}

}

void loop() {
  unsigned long now = millis();
  // High-level mode selection
  if (currentMode == START_SEQ) {
    if (start()) {
      stopMotors();
      currentMode = MAZE_NAV;
    }
    return; // Do not run maze logic in the same loop
  }

  if (currentMode == LINE_FOLLOW) {
    if (handleLineFollow()) {
      currentMode = DONE;
    }
    return;
  }

  if (currentMode == DONE) {
    stopMotors();
    gripper(GRIPPER_OPEN);
    return;
  }

  // MAZE_NAV mode
  readlineSensors();
  bool linePresent = false;
  for (int i = 0; i < NUM_SENSORS; i++) {
    if (sensorValues[i] < BLACK_THRESHOLD) {
      linePresent = true;
      break;
    }
  }
  if (linePresent) {
    stopMotors();
    currentMode = LINE_FOLLOW;
    return;
  }

  if (millis() - lastGripperPulse >= GRIPPER_CLOSE_INTERVAL) {
    gripper(GRIPPER_CLOSE);
    lastGripperPulse = millis();
  }

  if (currentState == MOVING_FORWARD) {
    servoWrite(70);
    currentDistance = readDistanceFiltered();
      
    if (currentDistance > 0 && currentDistance < WALL_DIST) {
      stopMotors();
      
      // back up a bit to make room 
      backwardMove();
      delay(150);
      stopMotors();

      int bestAngle = findBestDirection();
      if (bestAngle == 10) {
        startTurnRight(TURN_90_RIGHT);
      } else if (bestAngle == 130) {
        startTurnLeft(TURN_90_LEFT);
      } else {
        //no way out
        startTurnLeft(TURN_180);
      }
      segmentStartTime = millis();
      stuckCounter = 0; // Reset stuck counter
      return;
    }

    // Stuck detection logic
    if (now - lastStuckCheck > 400) { 
      float distDiff = abs(lastStuckDist - currentDistance);
      // If we have moved less than 3cm in 400ms, and we see a wall within 150cm
      if (currentDistance < 150 && distDiff < 3.0) {
        stuckCounter++;
      } else {
        stuckCounter = 0;
      }
      lastStuckDist = currentDistance;
      lastStuckCheck = now;

      if (stuckCounter >= 3) {
        //when stuck
        stopMotors();
        backwardMove();
        delay(400); 
        stopMotors();
        
        //trying to find an exit
        int bestAngle = findBestDirection();
        if (bestAngle == 10) {
          startTurnRight(TURN_90_RIGHT);
        } else if (bestAngle == 130) {
          startTurnLeft(TURN_90_LEFT);
        } else {
          startTurnLeft(TURN_180);
        }
        stuckCounter = 0;
        segmentStartTime = millis();
        return;
      }
    }

    forwardMove();
  }

  // finishing actions
  if (currentState != MOVING_FORWARD && currentState != ENTERING_OPENING && now - actionStartTime >= actionDuration) {
    stopMotors();
    currentState = MOVING_FORWARD;
    segmentStartTime = millis();
    justTurned = false;
  }
}

// servo stuff
void servoWrite(int angle) {
  angle = constrain(angle, 0, 180);
  int pulse = map(angle, 0, 180, 500, 2500);
  digitalWrite(SERVO_PIN, HIGH);
  delayMicroseconds(pulse);
  digitalWrite(SERVO_PIN, LOW);
  delayMicroseconds(20000 - pulse);
}

void moveServo(int angle, unsigned long duration) {
  unsigned long start = millis();
  while (millis() - start < duration) {
    servoWrite(angle);
  }
}

// ultrosonic sensor stuff
float readDistance() {
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);

  long duration = pulseIn(ECHO, HIGH, 18000); 
  if (duration == 0) return 0;
  return duration * 0.034 / 2.0;
}

float readDistanceFiltered() {
  float d1 = readDistance();
  delay(2);
  float d2 = readDistance();
  delay(2);
  float d3 = readDistance();

  if ((d1 <= d2 && d2 <= d3) || (d3 <= d2 && d2 <= d1)) return d2;
  if ((d2 <= d1 && d1 <= d3) || (d3 <= d1 && d1 <= d2)) return d1;
  return d3;
}

// fucntions 
void forwardMove() {
  analogWrite(LEFT_FWD, FORWARD_SPEED_WEAK);
  analogWrite(RIGHT_FWD, FORWARD_SPEED);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_BWD, 0);
}

void backwardMove() {
  analogWrite(LEFT_BWD, FORWARD_SPEED_WEAK);
  analogWrite(RIGHT_BWD, FORWARD_SPEED);
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_FWD, 0);
}

void stopMotors() {
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_BWD, 0);
}

void turnRight() {
  analogWrite(LEFT_FWD, TURN_SPEED_WEAK);
  analogWrite(RIGHT_BWD, TURN_SPEED);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(LEFT_BWD, 0);
}

void turnLeft() {
  analogWrite(RIGHT_FWD, TURN_SPEED);
  analogWrite(LEFT_BWD, TURN_SPEED_WEAK);
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_BWD, 0);
}


int findBestDirection() {
  scanningActive = true;
  isGlancing = false;
  headState = 0;

  float leftDist = 0, rightDist = 0;

  //looks right
  moveServo(10, 300);
  delay(60);
  rightDist = readDistanceFiltered();

  //looks left
  moveServo(130, 300);
  delay(60);
  leftDist = readDistanceFiltered();

  // back to center
  moveServo(70, 200);
  scanningActive = false;

  //checks which one has more space
  bool rightBlocked = (rightDist < CLEAR_DIST);
  bool leftBlocked  = (leftDist < CLEAR_DIST);

  if (!rightBlocked && !leftBlocked) {
    //for if both sides are free
    return (rightDist > leftDist) ? 10 : 130;
  } else if (!rightBlocked) {
    return 10;
  } else if (!leftBlocked) {
    return 130;
  } else {
    return 0; //when it returns 0 it needs to turn 180 degrees
  }
}

//turning left and saving its as an L
void startTurnLeft(unsigned long duration) {
  turnLeft();
  currentState = TURNING_LEFT;
  actionStartTime = millis();
  actionDuration = duration;
  justTurned = true;
  path[pathIndex++] = 'L';
}

void startTurnRight(unsigned long duration) {
  turnRight();
  currentState = TURNING_RIGHT;
  actionStartTime = millis();
  actionDuration = duration;
  justTurned = true;
  path[pathIndex++] = 'R';
}

void startBackward(unsigned long duration) {
  backwardMove();
  currentState = BACKING_UP;
  actionStartTime = millis();
  actionDuration = duration;
  path[pathIndex++] = 'B';
}

void startEnteringOpening() {
  forwardMove();
  currentState = ENTERING_OPENING;
  actionStartTime = millis();
  actionDuration = FORWARD_BEFORE_TURN;
  path[pathIndex++] = 'F';
}

//backtracking the path it has made
void backtrack() {
  if (pathIndex > 0) {
    char lastMove = path[--pathIndex];
    Serial.print("Backtracking, undoing: ");
    Serial.println(lastMove);

    if (lastMove == 'L') {
      startTurnRight(TURN_90_RIGHT);
    } else if (lastMove == 'R') {
      startTurnLeft(TURN_90_LEFT);
    } else if (lastMove == 'F') {
      startBackward(800);
    } else if (lastMove == 'B') {
      forwardMove();
    }
  }
}
//------------Start--------------
bool start(){
  // Simple timed start sequence to pick up and align before maze nav
  static long phaseStartTime = millis();
  static int phase = 0;
  static bool finished = false;

  if (finished) {
    return true;
  }
  
  if (phase == 0) {
    // Move forward for 1 second
    startmoveForward();
    if (millis() - phaseStartTime >= 1100) {
      stopMotors();
      phase = 1;
      phaseStartTime = millis();
    }
  } 
  else if (phase == 1) {
    // Stop and close gripper - stay in this phase for 500ms to allow gripper to close
    stopMotors();
    gripper(GRIPPER_CLOSE);
    if (millis() - phaseStartTime >= 500) {
      phase = 5;
      phaseStartTime = millis();
    }
  }
  else if (phase == 5) {
    // Move forward a bit to position before turning
    startmoveForward();  
    delay(450);
    phase = 2; 
  }
  else if (phase == 2) {
    // Turn left for a moment to align with the intended heading
    startturnLeft();
    delay(1100);
    phase = 3;
  }
  else if (phase == 3) {
    // Move forward to clear the start area
    startmoveForward();
    delay(1000); 
    stopMotors();
    finished = true;
  }

  return finished;
}

bool handleLineFollow(){
  readlineSensors();

  bool allBlack = true;
  for (int i = 0; i < NUM_SENSORS; i++) {
    if (sensorValues[i] >= BLACK_THRESHOLD) {
      allBlack = false;
      break;
    }
  }

  if (allBlack) {
    stopMotors();
    gripper(GRIPPER_OPEN);
    return true;
  }

  if (millis() - lastGripperPulse >= GRIPPER_CLOSE_INTERVAL) {
    gripper(GRIPPER_CLOSE);
    lastGripperPulse = millis();
  }

  if ((sensorValues[0] < BLACK_THRESHOLD) && (sensorValues[7] < BLACK_THRESHOLD)) {
    startmoveForward();
  }
  else if (sensorValues[0] < BLACK_THRESHOLD) {
    startturnLeft();
  }
  else if (sensorValues[7] < BLACK_THRESHOLD) {
    startturnRight();
  }
  else {
    startmoveForward();
  }

  return false;
}
// ------------ Read line sensors ------------
void readlineSensors(){
  static int lastSensorValues[NUM_SENSORS];
  static unsigned long timer;

  if (millis() > timer){
    for (int i = 0; i < NUM_SENSORS; i++){
      int currentValue = analogRead(sensorPins[i]);
      // Update stored value if it changed
      if (lastSensorValues[i] != currentValue){
        lastSensorValues[i] = currentValue;
      }
      // Store into global array
      sensorValues[i] = lastSensorValues[i];
    }
    // Refresh every 50 ms
    timer = millis() + 150;
  }
}
// ------------ start Turn left in place (non-blocking) ------------
void startturnLeft(){
  analogWrite(LEFT_FWD, 0);       // Left motor backward
  analogWrite(LEFT_BWD, START_TURN_LEFT_SPEED);
  analogWrite(RIGHT_FWD, START_TURN_RIGHT_SPEED);   // Right motor forward
  analogWrite(RIGHT_BWD, 0);
}
// ------------ start Turn right in place (non-blocking) ------------
void startturnRight(){
  analogWrite(LEFT_FWD, START_TURN_LEFT_SPEED);   // Left motor forward
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(RIGHT_BWD, START_TURN_RIGHT_SPEED); // Right motor backward
}
// ------------ Move forward  at start with given speeds ------------
void startmoveForward(){
  analogWrite(LEFT_FWD, START_LEFT_SPEED);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_FWD, START_RIGHT_SPEED);
  analogWrite(RIGHT_BWD, 0);
}

//----------------send servo pulses to gripper
void gripper(int pulse){
  static long last_pulse;
  static unsigned long timer;
  if (millis() - timer > 100){
    if (last_pulse != pulse){
      last_pulse = pulse;
    }
    digitalWrite(GRIPPER, 1);
    delayMicroseconds(last_pulse);
    digitalWrite(GRIPPER, 0);
    timer = millis()+50;
  }
}
