#include <Arduino.h>

#define LEFT_BWD   9
#define LEFT_FWD   6
#define RIGHT_BWD  5
#define RIGHT_FWD  3
//----------------servo neck and ultrasonic sensor pins
#define ECHO       12
#define TRIG       4
#define SERVO_PIN  8
//----------------line sensor pins
#define NUM_SENSORS 8
//----------------gripper pins
#define GRIPPER     13
#define GRIPPER_OPEN  1500
#define GRIPPER_CLOSE 1000

//----------------start essentials
const int START_LEFT_SPEED = 200; // SPEED FOR THE START
const int START_RIGHT_SPEED = 195;
const int START_TURN_LEFT_SPEED = 150;
const int START_TURN_RIGHT_SPEED = 145; // SPEED FOR THE FIRST LEFT TURN 
//----------------line sensor threshold
const int BLACK_THRESHOLD = 500; // THRESHOLD FOR THE LINE SENSORS
int sensorPins[NUM_SENSORS] = {              // Which Arduino pin each sensor is connected to
    A7, A6, A5, A4, A3, A2, A1, A0               // D1=A0 , D2=A1 , D3=A2 , D4=A3 , D5=A4 , D6=A5 , D7=A6 , D8=A7
};
int sensorValues[NUM_SENSORS];           // Latest analog value from each sensor
//----------------motor speed and distance constants
const int FORWARD_SPEED       = 150;
const int FORWARD_SPEED_WEAK  = 165;
const int TURN_SPEED          = 170;
const int TURN_SPEED_WEAK     = 185;
const float WALL_DIST         = 10.0;
const float CLEAR_DIST        = 30.0;
const unsigned long TURN_90_LEFT  = 525;
const unsigned long TURN_90_RIGHT = 650;
const unsigned long TURN_180      = 1200;


const unsigned long TIME_FOR_30CM = 2000;
const unsigned long FORWARD_BEFORE_TURN = 700;
const unsigned long GRIPPER_CLOSE_INTERVAL = 200;
//----------------FUNCTION AND VARIABLE DECLARATIONS
void forwardMove();
void backwardMove();
void stopMotors();
void turnRight();
void turnLeft();
int findBestDirection();
void startTurnLeft(unsigned long duration);
void startTurnRight(unsigned long duration);
void startBackward(unsigned long duration);
void startEnteringOpening();
void backtrack();
bool start();
void readlineSensors();
