// --- Setup Function (Runs Once) ---
void setup() {
  // Configure motor pins as outputs
  pinMode(LEFT_FWD, OUTPUT);
  pinMode(LEFT_BWD, OUTPUT);
  pinMode(RIGHT_FWD, OUTPUT);
  pinMode(RIGHT_BWD, OUTPUT);
  
  // Configure sensor pins
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);
  
  // Configure gripper pin
  pinMode(GRIPPER, OUTPUT);
  digitalWrite(GRIPPER, 1); // Trigger signal high
  digitalWrite(GRIPPER, 0); // Trigger signal low

  // Initialize systems
  servoInit();     // Servo
  neoInit();       // LEDs
  
  // Initialize Serial (for wireless module)
  Serial.begin(9600);
  delay(100);      // Wait for stabilization
  Serial.println("R3 Robot Online");
  
  // Initial state: Stopped with Red LEDs
  neoStop(); 
    
  // Center the head and ensure motors are stopped
  servoWrite(70);
  stopMotors();
  segmentStartTime = millis();

  // Pulse the gripper at startup to ensure it opens
  for (int i = 0; i < 50; i++) {
    digitalWrite(GRIPPER, HIGH);
    delayMicroseconds(GRIPPER_OPEN);
    digitalWrite(GRIPPER, LOW);
    delay(20);
  }
}

// --- Main Loop (Runs Repeatedly) ---
void loop() {
  static long phaseStartTime = millis(); // Timer for phases
  static int phase = -1;                 // Current phase number (-1 = Waiting for Start)
  static bool wallDetected = false;      // Flag for wall obstacle
  static unsigned long allBlackStartTime = 0; // Timer for end-of-maze detection
  
  // ==================== PHASE -1: Wait for Signal ====================
  if (phase == -1) {
    static unsigned long lastHeartbeat = 0;
    if (millis() - lastHeartbeat >= 2000) {
      Serial.println("R3 Waiting for start signal..."); 
      lastHeartbeat = millis();
    }
  
    if (Serial.available() > 0) {
      String income = Serial.readStringUntil('\n');
      income.trim();
      
      // Listen for generic START or specific R3:START_R3 / R3:START
      if (income.equalsIgnoreCase("START") || 
          income.equalsIgnoreCase("START_R3") || 
          income.equalsIgnoreCase("R3:START_R3") || 
          income.equalsIgnoreCase("R3:START")) {
        
        Serial.println("R3 Start Signal Received!");
        Serial.println("R3 I started the race");
        phase = 0; // Move to Phase 0
        phaseStartTime = millis();
      }
    }
    return; // Keep waiting
  }
  
  static bool allBlackDetected = false;  // Flag for stable end-of-maze signal
  static const char* lastDirection = "IDLE"; // Debug string
  
  // Status Report: Speed (every 1 sec)
  static unsigned long lastSpeedReport = 0;
  if (millis() - lastSpeedReport > 1000) {
      Serial.print("R3 Motor Speed: ");
      Serial.println(FORWARD_SPEED);
      lastSpeedReport = millis();
  }
  
  // ==================== PHASE 0: Initial Move Forward ====================
  if (phase == 0) {
    lastDirection = "FORWARD";
    startmoveForward(); // Move forward blindly at start speed
    
    // Run for 1100 ms
    if (millis() - phaseStartTime >= 1100) {
      stopMotors();
      phase = 1;                  // Go to Phase 1
      phaseStartTime = millis();  // Reset timer
    }
  } 
  
  // ==================== PHASE 1: Stop and Grab ====================
  else if (phase == 1) {
    lastDirection = "STOPPED";
    stopMotors();                 // Ensure stopped
    Serial.println("R3 Picking up Cone");
    gripper(GRIPPER_CLOSE);       // Close gripper
    
    // Wait for 500 ms
    if (millis() - phaseStartTime >= 500) {
      phase = 2;                  // Go to Phase 2
      phaseStartTime = millis();
    }
  }
  
  // ==================== PHASE 2: Short Forward Move ====================
  else if (phase == 2) {
    lastDirection = "FORWARD";
    gripper(GRIPPER_CLOSE);       // Keep gripping
    startmoveForward();           // Move forward
    
    // Run for 300 ms
    if (millis() - phaseStartTime >= 150) {
      stopMotors();
      phase = 3;                  // Go to Phase 3
      phaseStartTime = millis();
    }
  }
  
  // ==================== PHASE 3: Initial Turn Left ====================
  else if (phase == 3) {
    lastDirection = "TURN_LEFT";
    gripper(GRIPPER_CLOSE);       // Keep gripping
    Serial.println("R3 Turning Left (Initial)");
    startturnLeft();              // Turn left
    
    // Turn duration (Adjust this if turning too much/little)
    // 630ms: Adjusted down from 750ms because of higher turn power
    if (millis() - phaseStartTime >= 630) {
      stopMotors();
      phase = 4;                  // Go to Main Maze Phase
      phaseStartTime = millis();
      wallDetected = false;
    }
  }
  
  // ==================== PHASE 4: Maze Solving (Ultrasonic) ====================
  else if (phase == 4) {
    
    // Timeout Safety: If solving takes > 180 seconds, stop.
    if (millis() - phaseStartTime > 180000) {
      stopMotors();
      gripper(GRIPPER_CLOSE);
      phase = 2; // (Looping back or error state)
      return;
    }
    
    // 1. Check Floor for End of Maze (All Black)
    readlineSensors();
    
    bool allBlack = true; // Assume all black until proven otherwise
    for (int i = 0; i < NUM_SENSORS; i++) {
      // If ANY sensor sees white (High Value), it's not all black
      if (sensorValues[i] >= BLACK_THRESHOLD) {
        allBlack = false;
        break;
      }
    }
    
    // Debounce the black detection (Must be black for 500ms continuous)
    if (allBlack) {
      if (!allBlackDetected) {
        allBlackStartTime = millis(); // Start timer
        allBlackDetected = true;
      } else if (millis() - allBlackStartTime >= 300) {
        // Confirmed End of Maze!
        stopMotors();
        Serial.println("R3 Dropping Cone");
        gripper(GRIPPER_OPEN);    // Drop payload
        Serial.println("R3 Race Finished");
        phase = 5;                // Go to End Phase
        return;
      }
    } else {
      allBlackDetected = false;   // Reset if we see white
    }
    
    // 2. Navigation with Ultrasonic Sensor
    servoWrite(70);               // Look forward
    currentDistance = readDistanceFiltered(); // Measure distance
    
    gripper(GRIPPER_CLOSE);       // Ensure we hold the object
    
    // If obstacle is close (< 13cm) - Increased to 13cm for safer turning clearance
    if (currentDistance > 0 && currentDistance < 13.0) {
      Serial.println("R3 OBJECT FOUND!!!");
      stopMotors();
      wallDetected = true;        // Flag that we hit a wall
      
      static unsigned long lastWallCheck = 0;
      
      // Check (Start scan after a brief vibration settle time)
      if (millis() - lastWallCheck > 300) {
        lastWallCheck = millis();
        
        // --- Wall Logic: SCAN BOTH & DECIDE ---
        
        // 1. Look Right (Slower, cleaner move)
        moveServo(10, 250);
        delay(250);           // Allow sensor to steady
        float rightDist = readDistanceFiltered();

        // 2. Look Left (Longer swing, steady move)
        moveServo(130, 400);
        delay(250);           // Allow sensor to steady
        float leftDist = readDistanceFiltered();
        
        // 3. Center Head
        moveServo(70, 150);

        // Treat 0 as Infinity
        float effectiveRight = (rightDist == 0) ? 999.0 : rightDist;
        float effectiveLeft  = (leftDist  == 0) ? 999.0 : leftDist;

        bool rightOpen = (effectiveRight > 20.0);
        bool leftOpen  = (effectiveLeft  > 20.0);

        // Case: Dead End (3 Walls: Front, Right, Left)
        if (!rightOpen && !leftOpen) {
            Serial.println("R3 Dead End (3 Walls) - 180 Turn");
            backwardMove(); 
            delay(400);   // Back up
            stopMotors();
            delay(100);
            
            // Execute 180 Turn
            turnLeft();   // Turning Left is often safer for 180
            delay(1500);  // Time for ~180 degrees at new speed
            stopMotors();
            wallDetected = false;
        }
        // Case: Only Left is Open
        else if (!rightOpen && leftOpen) {
             Serial.println("R3 Logic: Right Blocked -> Going LEFT");
             turnLeft();
             delay(550); // Standard Turn
             stopMotors();
             wallDetected = false;
        }
        // Case: Only Right is Open
        else if (rightOpen && !leftOpen) {
             Serial.println("R3 Logic: Left Blocked -> Going RIGHT");
             turnRight();
             delay(550); // Standard Turn
             stopMotors();
             wallDetected = false;
        }
        // Case: Both Open (Intersection) -> Compare Distances
        else {
             // Logic: Pick the path with significantly more space. 
             // If similar (within 15cm), prefer RIGHT (Right-Hand Rule bias).
             
             if (abs(effectiveRight - effectiveLeft) < 15.0) {
                 Serial.println("R3 Logic: Similar Space -> Defaulting RIGHT");
                 turnRight();
                 delay(550);
             }
             else if (effectiveRight > effectiveLeft) {
                 Serial.println("R3 Logic: Both Open -> RIGHT has more space");
                 turnRight();
                 delay(550);
             } else {
                 Serial.println("R3 Logic: Both Open -> LEFT has more space");
                 turnLeft();
                 delay(550);
             }
             stopMotors();
             wallDetected = false;
        }
      }
    }
    // No obstacle ahead
    else if (!wallDetected) {
      servoWrite(70);             // Look forward
      forwardMove();              // Go!
      
      // 3. Stuck Detection
      // (If we think we are moving forward, but distance to wall doesn't change)
      if (millis() - lastStuckCheck > 800) {
        float distChange = abs(currentDistance - lastStuckDist);
        
        // If distance unchanged (< 2cm) but we see a wall (< 50cm)
        if (distChange < 2.0 && currentDistance > 0 && currentDistance < 50.0) {
          stuckCounter++;
          
          // If stuck twice consecutive checks -> Recovery
          if (stuckCounter >= 2) {
            Serial.println("R3 Stuck - Trying to get out (No Progress)");
            stopMotors();
            delay(100);
            
            // Backup more aggressively:
            // 800ms normally, but if really stuck loop, backup even more (1200ms)
            unsigned long backupTime = (totalStuckAttempts > 2) ? 1200 : 800;
            backwardMove();       
            delay(backupTime);
            stopMotors();
            delay(200);
            
            // Intelligence: Check which side is open, but alternate strategy if stuck repeatedly
            int bestDir = findBestDirection();
            
            totalStuckAttempts++; // Increment total attempts
            
            // If we have tried significantly (e.g., > 3 times) and failed, force a RIGHT turn
            // This handles cases where "Best Direction" leads us back into the stuck spot
            if (totalStuckAttempts > 3) {
                 Serial.println("Stuck loop detected! Forcing RIGHT turn.");
                 turnRight(); 
                 // Reset after a forced move to try normal logic again later
                 if (totalStuckAttempts > 5) totalStuckAttempts = 0; 
            }
            else {
              // Normal Logic: Use sensors
              if (bestDir == 10) {
                 turnRight(); // Twist Right
              } else if (bestDir == 130) {
                 turnLeft();  // Twist Left
              } else {
                 turnRight(); // Default Twist Right if both blocked/uncertain
              }
            }
            
            // Turn Time: Increased significantly to actually change direction
            delay(750);
            stopMotors();
            stuckCounter = 0;   // Reset specific counter
          }
        } else {
          stuckCounter = 0;       // Moving fine
          totalStuckAttempts = 0; // Reset total attempts since we moved successfully
        }
        
        lastStuckDist = currentDistance;
        lastStuckCheck = millis();
      }
    }
  }
  
  // ==================== PHASE 5: Finished ====================
  else if (phase == 5) {
    stopMotors();
    gripper(GRIPPER_OPEN);
    // Do nothing, just stay stopped
  }
}

// --- Helper Functions ---

// Global Servo object
Servo neckServo;

// Initialize Servo
void servoInit() {
  neckServo.attach(SERVO_PIN);
  neckServo.write(70); // Center
}

// Write to Servo (SAFE)
void servoWrite(int angle) {
  angle = constrain(angle, 0, 180); // Protect boundaries
  neckServo.write(angle);
}

// Move Servo with Delay
void moveServo(int angle, unsigned long duration) {
    servoWrite(angle);
    delay(duration); // Wait for move
}

// Read Ultrasonic Distance (Raw)
float readDistance() {
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  
  digitalWrite(TRIG, HIGH);      // Send pulse
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);
  
  long duration = pulseIn(ECHO, HIGH, 30000); // Read echo
  
  if (duration == 0) return 0;   // Timeout
  
  // Convert time to cm (Speed of Sound)
  return duration * 0.0343 / 2.0;
}

// Read Ultrasonic Distance (Filtered Median)
float readDistanceFiltered() {
  float d1 = readDistance();
  delay(2);
  float d2 = readDistance();
  delay(2);
  float d3 = readDistance();

  // Return Median of 3
  if ((d1 <= d2 && d2 <= d3) || (d3 <= d2 && d2 <= d1)) return d2;
  if ((d2 <= d1 && d1 <= d3) || (d3 <= d1 && d1 <= d2)) return d1;
  return d3;
}

// Set range of NeoPixels color
static void setStripColor(uint8_t startIdx, uint8_t count, uint8_t r, uint8_t g, uint8_t b) {
  for (uint16_t i = startIdx; i < startIdx + count && i < strip.numPixels(); i++) {
    strip.setPixelColor(i, strip.Color(r, g, b));
  }
}

// Show Red Stop Lights
static void showStop() {
  setStripColor(0, TOTAL_PIXELS, 255, 0, 0);
  strip.show();
}

// Initialize NeoPixels
void neoInit() {
  strip.begin();
  strip.setBrightness(60);
  showStop();
}

// Show Turning Left Lights
void neoLeft() {
  if (lastNeoState != "LEFT"){
  setStripColor(LEFT_START, LEFT_NEOPIXELS, 0, 255, 0);       // Left Green
  setStripColor(RIGHT_START, RIGHT_NEOPIXELS, 255, 255, 255); // Right White
  strip.show();
  lastNeoState = "LEFT";
  }
}

// Show Turning Right Lights
void neoRight() {
  if (lastNeoState != "RIGHT"){
  setStripColor(RIGHT_START, RIGHT_NEOPIXELS, 0, 255, 0);     // Right Green
  setStripColor(LEFT_START, LEFT_NEOPIXELS, 255, 255, 255);   // Left White
  strip.show();
  lastNeoState = "RIGHT";
  }
}

// Show Forward Lights
void neoStraight() {
  if (lastNeoState != "STRAIGHT"){
  setStripColor(0, TOTAL_PIXELS, 255, 255, 255);              // All White
  strip.show();
  lastNeoState = "STRAIGHT";
}
}

// Show Stop Lights (with State Check)
void neoStop() {
  if (lastNeoState != "STOP"){
  showStop();
  lastNeoState = "STOP";
}
}

// --- Movement Implementation ---

void forwardMove() {
  neoStraight();
  analogWrite(LEFT_FWD, FORWARD_SPEED_WEAK);
  analogWrite(RIGHT_FWD, FORWARD_SPEED);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_BWD, 0);
}

void backwardMove() {
  analogWrite(LEFT_BWD, FORWARD_SPEED_WEAK);
  analogWrite(RIGHT_BWD, FORWARD_SPEED);
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_FWD, 0);
}

void stopMotors() {
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_BWD, 0);
  neoStop();
}

void turnRight() {
  neoRight();
  analogWrite(LEFT_FWD, TURN_SPEED_WEAK);
  analogWrite(RIGHT_BWD, TURN_SPEED);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(LEFT_BWD, 0);
}

void turnLeft() {
  neoLeft();
  analogWrite(RIGHT_FWD, TURN_SPEED);
  analogWrite(LEFT_BWD, TURN_SPEED_WEAK);
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_BWD, 0);
}

// (Optional) Best Direction Finder
int findBestDirection() {
  scanningActive = true;
  isGlancing = false;
  headState = 0;

  float leftDist = 0, rightDist = 0;

  // Look Right
  moveServo(10, 300);
  delay(60);
  rightDist = readDistanceFiltered();

  // Look Left
  moveServo(130, 300);
  delay(60);
  leftDist = readDistanceFiltered();

  // Center
  moveServo(70, 200);
  scanningActive = false;

  // Treat 0 as Infinity (Open)
  float effectiveRight = (rightDist == 0) ? 999.0 : rightDist;
  float effectiveLeft  = (leftDist == 0) ? 999.0 : leftDist;

  bool rightBlocked = (effectiveRight < CLEAR_DIST);
  bool leftBlocked  = (effectiveLeft < CLEAR_DIST);
  
  if (!rightBlocked && !leftBlocked) {
    return (effectiveRight > effectiveLeft) ? 10 : 130; // Pick larger gap
  } else if (!rightBlocked) {
    return 10;
  } else if (!leftBlocked) {
    return 130;
  } else {
    return 0; // Turn around (though caller usually defaults to Turn Right)
  }
}

// --- Path Tracking Helpers ---

void startTurnLeft(unsigned long duration) {
  turnLeft();
  currentState = TURNING_LEFT;
  actionStartTime = millis();
  actionDuration = duration;
  justTurned = true;
  path[pathIndex++] = 'L'; // Save 'L' to path
}

void startTurnRight(unsigned long duration) {
  turnRight();
  currentState = TURNING_RIGHT;
  actionStartTime = millis();
  actionDuration = duration;
  justTurned = true;
  path[pathIndex++] = 'R'; // Save 'R' to path
}

void startBackward(unsigned long duration) {
  backwardMove();
  currentState = BACKING_UP;
  actionStartTime = millis();
  actionDuration = duration;
  path[pathIndex++] = 'B';
}

void startEnteringOpening() {
  forwardMove();
  currentState = ENTERING_OPENING;
  actionStartTime = millis();
  actionDuration = FORWARD_BEFORE_TURN;
  path[pathIndex++] = 'F';
}

void backtrack() {
  if (pathIndex > 0) {
    char lastMove = path[--pathIndex];
    Serial.print("Backtracking, undoing: ");
    Serial.println(lastMove);

    if (lastMove == 'L') {
      startTurnRight(TURN_90_RIGHT);
    } else if (lastMove == 'R') {
      startTurnLeft(TURN_90_LEFT);
    } else if (lastMove == 'F') {
      startBackward(800);
    } else if (lastMove == 'B') {
      forwardMove();
    }
  }
}

// Start Sequence Helpers
void startturnLeft(){
  neoLeft();
  analogWrite(LEFT_FWD, 0);                   
  analogWrite(LEFT_BWD, START_TURN_LEFT_SPEED);
  analogWrite(RIGHT_FWD, START_TURN_RIGHT_SPEED);
  analogWrite(RIGHT_BWD, 0);
}

void startmoveForward(){
  neoStraight();
  analogWrite(LEFT_FWD, START_LEFT_SPEED);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_FWD, START_RIGHT_SPEED);
  analogWrite(RIGHT_BWD, 0);
}

// Line Sensor Reader (Optimized)
void readlineSensors(){
  static int lastSensorValues[NUM_SENSORS];
  static unsigned long timer;

  if (millis() > timer){
    for (int i = 0; i < NUM_SENSORS; i++){
      int currentValue = analogRead(sensorPins[i]);
      if (lastSensorValues[i] != currentValue){
        lastSensorValues[i] = currentValue;
      }
      sensorValues[i] = lastSensorValues[i];
    }
    timer = millis() + 150; // Check every 150ms
  }
}

// Pulse Gripper
void gripper(int pulse){
  static long last_pulse;
  static unsigned long timer;
  if (millis() - timer > 100){
    if (last_pulse != pulse){
      last_pulse = pulse;
    }
    digitalWrite(GRIPPER, 1);
    delayMicroseconds(last_pulse);
    digitalWrite(GRIPPER, 0);
    timer = millis()+50;
  }
}
