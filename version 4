void setup() {
  pinMode(LEFT_FWD, OUTPUT);
  pinMode(LEFT_BWD, OUTPUT);
  pinMode(RIGHT_FWD, OUTPUT);
  pinMode(RIGHT_BWD, OUTPUT);
  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);
  pinMode(GRIPPER, OUTPUT);
  digitalWrite(GRIPPER, 1); 
  digitalWrite(GRIPPER, 0);

  

  // Initialize servo
  servoInit();

  // Initialize NeoPixels
  neoInit();

  // Initialize Serial for HC-12 communication
  Serial.begin(9600);
  delay(100);
  
  // Wait for remote START command
  neoStop(); // Show red LEDs
  while (!remoteStartEnabled) {
    checkRemoteCommands();
    delay(10);
  }
  
  // Robot started via remote command
  sendStatus("STARTED");
  
  Serial.println("ROBOT_READY");
  
  servoWrite(70);
  stopMotors();
  segmentStartTime = millis();

  // Send multiple pulses to ensure gripper opens
for (int i = 0; i < 50; i++) {
  digitalWrite(GRIPPER, HIGH);
  delayMicroseconds(GRIPPER_OPEN);
  digitalWrite(GRIPPER, LOW);
  delay(20);
}

}

void loop() {
  static long phaseStartTime = millis();
  static int phase = 0;
  static bool wallDetected = false;
  static unsigned long allBlackStartTime = 0;
  static bool allBlackDetected = false;
  static const char* lastDirection = "IDLE";
  
  // Check for remote commands
  checkRemoteCommands();
  
  // Send status periodically
  unsigned long now = millis();
  if (now - lastStatusSend >= STATUS_INTERVAL) {
    sendStatus(lastDirection);
    lastStatusSend = now;
  }
  
  // ==================== PHASE 0: Move forward ====================
  if (phase == 0) {
    lastDirection = "FORWARD";
    startmoveForward();
    if (millis() - phaseStartTime >= 1100) {
      stopMotors();
      phase = 1;
      phaseStartTime = millis();
    }
  } 
  
  // ==================== PHASE 1: Stop and close gripper ====================
  else if (phase == 1) {
    lastDirection = "STOPPED";
    stopMotors();
    gripper(GRIPPER_CLOSE);
    if (millis() - phaseStartTime >= 500) {
      phase = 2;
      phaseStartTime = millis();
    }
  }
  
  // ==================== PHASE 2: Move forward ====================
  else if (phase == 2) {
    lastDirection = "FORWARD";
    gripper(GRIPPER_CLOSE); // Keep gripper closed
    startmoveForward();  
    if (millis() - phaseStartTime >= 900) {
      stopMotors();
      phase = 3;
      phaseStartTime = millis();
    }
  }
  
  // ==================== PHASE 3: Turn left ====================
  else if (phase == 3) {
    lastDirection = "TURN_LEFT";
    gripper(GRIPPER_CLOSE); // Keep gripper closed
    startturnLeft();
    if (millis() - phaseStartTime >= 1100) {
      stopMotors();
      phase = 4;
      phaseStartTime = millis();
      wallDetected = false;
    }
  }
  
  // ==================== PHASE 4: Maze solving with ultrasonic sensor ====================
  else if (phase == 4) {
    
    // Keep gripper closed during maze solving
    gripper(GRIPPER_CLOSE);
    
    // Read line sensors to check for all black condition
    readlineSensors();
    
    // Check if ALL sensors detect black
    bool allBlack = true;
    for (int i = 0; i < NUM_SENSORS; i++) {
      if (sensorValues[i] >= BLACK_THRESHOLD) {
        allBlack = false;
        break;
      }
    }
    
    // Track how long all sensors have been black
    if (allBlack) {
      if (!allBlackDetected) {
        // First time detecting all black, start timer
        allBlackStartTime = millis();
        allBlackDetected = true;
      } else if (millis() - allBlackStartTime >= 500) {
        // All black for 500ms, stop and open gripper
        stopMotors();
        gripper(GRIPPER_OPEN);
        phase = 5; // End phase
        return;
      }
    } else {
      // Not all black, reset detection
      allBlackDetected = false;
    }
    
    // Position sensor forward and check front wall
    servoWrite(70);
    currentDistance = readDistanceFiltered();
    
    // Check if wall is less than 20cm away
    if (currentDistance > 0 && currentDistance < 20.0) {
      stopMotors();
      wallDetected = true;
      
      // Turn sensor left and check distance
      moveServo(130, 300);
      delay(60);
      float leftDistance = readDistanceFiltered();
      
      // If wall is less than 10cm on left, turn robot left
      if (leftDistance > 0 && leftDistance < 10.0) {
        // Turn robot left
        startturnLeft();
        if (millis() - phaseStartTime >= TURN_90_LEFT) {
          stopMotors();
          phaseStartTime = millis();
        }
      } 
      else {
        // No wall on left, turn sensor right to check
        moveServo(10, 300);
        delay(60);
        float rightDistance = readDistanceFiltered();
        
        // If wall less than 10cm on right, turn neck forward and back out
        if (rightDistance > 0 && rightDistance < 10.0) {
          moveServo(70, 200); // Turn neck forward
          // Back out / reverse
          startBackward(400);
          if (millis() - phaseStartTime >= 500) {
            stopMotors();
            phaseStartTime = millis();
            // Check walls again
            wallDetected = false;
          }
        } 
        else {
          // Both sides clear, continue moving forward
          moveServo(70, 200); // Center sensor
          startmoveForward();
          wallDetected = false;
        }
      }
    }
    else if (!wallDetected) {
      // No wall ahead, keep moving forward
      servoWrite(70);
      startmoveForward();
    }
  }
  
  // ==================== PHASE 5: End - gripper open ====================
  else if (phase == 5) {
    stopMotors();
    gripper(GRIPPER_OPEN);
    // Stay in this state
  }
}

// servo stuff - using Servo library for proper PWM
Servo neckServo;

void servoInit() {
  neckServo.attach(SERVO_PIN);
  neckServo.write(70); // Center position
}

void servoWrite(int angle) {
  angle = constrain(angle, 0, 180);
  neckServo.write(angle);
}

void moveServo(int angle, unsigned long duration) {
  unsigned long start = millis();
  while (millis() - start < duration) {
    servoWrite(angle);
    delayMicroseconds(100);
  }
}

// ultrosonic sensor stuff
float readDistance() {
  // Ensure trigger pin is low
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  
  // Send 10us pulse on trigger pin
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);
  
  // Wait for echo to return (with 30ms timeout)
  long duration = pulseIn(ECHO, HIGH, 30000); 
  
  if (duration == 0) return 0; // Timeout or no echo
  
  // Convert time to distance in cm
  // Speed of sound = 343 m/s = 0.0343 cm/us
  // Distance = (duration * 0.0343) / 2
  return duration * 0.0343 / 2.0;
}

float readDistanceFiltered() {
  float d1 = readDistance();
  delay(2);
  float d2 = readDistance();
  delay(2);
  float d3 = readDistance();

  if ((d1 <= d2 && d2 <= d3) || (d3 <= d2 && d2 <= d1)) return d2;
  if ((d2 <= d1 && d1 <= d3) || (d3 <= d1 && d1 <= d2)) return d1;
  return d3;
}

// NeoPixel helpers
static void setStripColor(Adafruit_NeoPixel &strip, uint8_t r, uint8_t g, uint8_t b) {
  for (uint16_t i = 0; i < strip.numPixels(); i++) {
    strip.setPixelColor(i, strip.Color(r, g, b));
  }
  strip.show();
}

void neoInit() {
  stripLeft.begin();
  stripRight.begin();
  stripLeft.setBrightness(60);
  stripRight.setBrightness(60);
  // default to stopped (red)
  setStripColor(stripLeft, 255, 0, 0);
  setStripColor(stripRight, 255, 0, 0);
}

void neoLeft() {
  setStripColor(stripLeft, 0, 255, 0);   // left green
  setStripColor(stripRight, 0, 0, 0);    // right off
}

void neoRight() {
  setStripColor(stripLeft, 0, 0, 0);     // left off
  setStripColor(stripRight, 0, 255, 0);  // right green
}

void neoStraight() {
  setStripColor(stripLeft, 255, 255, 255);  // white
  setStripColor(stripRight, 255, 255, 255); // white
}

void neoStop() {
  setStripColor(stripLeft, 255, 0, 0);   // red
  setStripColor(stripRight, 255, 0, 0);  // red
}

// fucntions 
void forwardMove() {
  neoStraight();
  analogWrite(LEFT_FWD, FORWARD_SPEED_WEAK);
  analogWrite(RIGHT_FWD, FORWARD_SPEED);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_BWD, 0);
}

void backwardMove() {
  analogWrite(LEFT_BWD, FORWARD_SPEED_WEAK);
  analogWrite(RIGHT_BWD, FORWARD_SPEED);
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_FWD, 0);
}

void stopMotors() {
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(LEFT_BWD, 0);
  analogWrite(RIGHT_BWD, 0);
  neoStop();
}

void turnRight() {
  neoRight();
  analogWrite(LEFT_FWD, TURN_SPEED_WEAK);
  analogWrite(RIGHT_BWD, TURN_SPEED);
  analogWrite(RIGHT_FWD, 0);
  analogWrite(LEFT_BWD, 0);
}

void turnLeft() {
  neoLeft();
  analogWrite(RIGHT_FWD, TURN_SPEED);
  analogWrite(LEFT_BWD, TURN_SPEED_WEAK);
  analogWrite(LEFT_FWD, 0);
  analogWrite(RIGHT_BWD, 0);
}


int findBestDirection() {
  scanningActive = true;
  isGlancing = false;
  headState = 0;

  float leftDist = 0, rightDist = 0;

  //looks right
  moveServo(10, 300);
  delay(60);
  rightDist = readDistanceFiltered();

  //looks left
  moveServo(130, 300);
  delay(60);
  leftDist = readDistanceFiltered();

  // back to center
  moveServo(70, 200);
  scanningActive = false;

  //checks which one has more space
  bool rightBlocked = (rightDist < CLEAR_DIST);
  bool leftBlocked  = (leftDist < CLEAR_DIST);

  if (!rightBlocked && !leftBlocked) {
    //for if both sides are free
    return (rightDist > leftDist) ? 10 : 130;
  } else if (!rightBlocked) {
    return 10;
  } else if (!leftBlocked) {
    return 130;
  } else {
    return 0; //when it returns 0 it needs to turn 180 degrees
  }
}

