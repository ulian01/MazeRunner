void loop() {
  static long phaseStartTime = millis();
  static int phase = 0;
  static bool wallDetected = false;
  static unsigned long allBlackStartTime = 0;
  static bool allBlackDetected = false;
  static const char* lastDirection = "IDLE";
  
  
  // ==================== PHASE 0: Move forward ====================
  if (phase == 0) {
    lastDirection = "FORWARD";
    startmoveForward();
    if (millis() - phaseStartTime >= 1100) {
      stopMotors();
      phase = 1;
      phaseStartTime = millis();
    }
  } 
  
  // ==================== PHASE 1: Stop and close gripper ====================
  else if (phase == 1) {
    lastDirection = "STOPPED";
    stopMotors();
    gripper(GRIPPER_CLOSE);
    if (millis() - phaseStartTime >= 500) {
      phase = 2;
      phaseStartTime = millis();
    }
  }
  
  // ==================== PHASE 2: Move forward ====================
  else if (phase == 2) {
    lastDirection = "FORWARD";
    gripper(GRIPPER_CLOSE); // Keep gripper closed
    startmoveForward();  
    if (millis() - phaseStartTime >= 300) {
      stopMotors();
      phase = 3;
      phaseStartTime = millis();
    }
  }
  
  // ==================== PHASE 3: Turn left ====================
  else if (phase == 3) {
    lastDirection = "TURN_LEFT";
    gripper(GRIPPER_CLOSE); // Keep gripper closed
    startturnLeft();
    if (millis() - phaseStartTime >= 1000) {
      stopMotors();
      phase = 4;
      phaseStartTime = millis();
      wallDetected = false;
    }
  }
  
  // ==================== PHASE 4: Maze solving with ultrasonic sensor ====================
  else if (phase == 4) {
    
    // Safety timeout - if phase 4 lasts too long (120 seconds), give up and open gripper
    if (millis() - phaseStartTime > 120000) {
      stopMotors();
      gripper(GRIPPER_OPEN);
      phase = 5;
      return;
    }
    
    // Read line sensors to check for all black condition
    readlineSensors();
    
    // Check if ALL sensors detect black
    bool allBlack = true;
    for (int i = 0; i < NUM_SENSORS; i++) {
      if (sensorValues[i] >= BLACK_THRESHOLD) {
        allBlack = false;
        break;
      }
    }
    
    // Track how long all sensors have been black
    if (allBlack) {
      if (!allBlackDetected) {
        // First time detecting all black, start timer
        allBlackStartTime = millis();
        allBlackDetected = true;
      } else if (millis() - allBlackStartTime >= 500) {
        // All black for 500ms, stop and open gripper
        stopMotors();
        gripper(GRIPPER_OPEN);
        phase = 5; // End phase
        return;
      }
    } else {
      // Not all black, reset detection
      allBlackDetected = false;
    }
    
    // Position sensor forward and check front wall
    servoWrite(70);
    currentDistance = readDistanceFiltered();
    
    // Keep gripper closed regardless of navigation state
    gripper(GRIPPER_CLOSE);
    
    // Check if wall is less than 15cm away
    if (currentDistance > 0 && currentDistance < 15.0) {
      stopMotors();
      wallDetected = true;
      
      static unsigned long lastWallCheck = 0;
      
      // Only check walls every 500ms to avoid rapid repeated checks
      if (millis() - lastWallCheck > 500) {
        lastWallCheck = millis();
        
        // Turn sensor right first and check distance
        moveServo(10, 300);
        delay(300);
        float rightDistance = readDistanceFiltered();
        
        // If right side is open (distance > 25cm), turn robot right
        if (rightDistance > 0 && rightDistance > 25.0) {
          // Turn neck back to center
          moveServo(70, 200);
          // Turn robot right
          turnRight();
          delay(500);
          stopMotors();
          wallDetected = false;
        } 
        else {
          // Right is blocked, check left
          moveServo(130, 300);
          delay(300);
          float leftDistance = readDistanceFiltered();
          
          // If left side is open (distance > 25cm), turn robot left
          if (leftDistance > 0 && leftDistance > 25.0) {
            moveServo(70, 200); // Turn neck forward
            // Turn robot left
            turnLeft();
            delay(500);
            stopMotors();
            wallDetected = false;
          } 
          else {
            // Both sides blocked, back out then turn around
            moveServo(70, 200); // Center sensor
            backwardMove();
            delay(400);
            stopMotors();
            delay(100);
            // Turn around (180 degrees)
            turnRight();
            delay(1300);
            stopMotors();
            wallDetected = false;
          }
        }
      }
    }
    else if (!wallDetected) {
      // No wall ahead, keep moving forward
      servoWrite(70);
      forwardMove();
      
      // Stuck detection - check if robot is actually moving
      if (millis() - lastStuckCheck > 1000) {
        float distChange = abs(currentDistance - lastStuckDist);
        
        // If distance hasn't changed much in 1 second while moving forward, robot might be stuck
        if (distChange < 2.0 && currentDistance > 0 && currentDistance < 50.0) {
          stuckCounter++;
          
          // If stuck twice in a row, back out and retry
          if (stuckCounter >= 2) {
            stopMotors();
            delay(100);
            // Back up
            backwardMove();
            delay(500);
            stopMotors();
            delay(100);
            // Turn slightly to avoid obstacle
            turnRight();
            delay(400);
            stopMotors();
            stuckCounter = 0;
          }
        } else {
          // Robot is moving, reset stuck counter
          stuckCounter = 0;
        }
        
        lastStuckDist = currentDistance;
        lastStuckCheck = millis();
      }
    }
  }
  
  // ==================== PHASE 5: End - gripper open ====================
  else if (phase == 5) {
    stopMotors();
    gripper(GRIPPER_OPEN);
    // Stay in this state
  }
}

// servo stuff - using Servo library for proper PWM
Servo neckServo;

void servoInit() {
  neckServo.attach(SERVO_PIN);
  neckServo.write(70); // Center position
}

void servoWrite(int angle) {
  angle = constrain(angle, 0, 180);
  neckServo.write(angle);
}

void moveServo(int angle, unsigned long duration) {

    servoWrite(angle);
    delay(duration);
}

// ultrosonic sensor stuff
float readDistance() {
  // Ensure trigger pin is low
  digitalWrite(TRIG, LOW);
  delayMicroseconds(2);
  
  // Send 10us pulse on trigger pin
  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);
  
  // Wait for echo to return (with 30ms timeout)
  long duration = pulseIn(ECHO, HIGH, 30000); 
  
  if (duration == 0) return 0; // Timeout or no echo
  
  // Convert time to distance in cm
  // Speed of sound = 343 m/s = 0.0343 cm/us
  // Distance = (duration * 0.0343) / 2
  return duration * 0.0343 / 2.0;
}

float readDistanceFiltered() {
  float d1 = readDistance();
  delay(2);
  float d2 = readDistance();
  delay(2);
  float d3 = readDistance();

  if ((d1 <= d2 && d2 <= d3) || (d3 <= d2 && d2 <= d1)) return d2;
  if ((d2 <= d1 && d1 <= d3) || (d3 <= d1 && d1 <= d2)) return d1;
  return d3;
}

// NeoPixel helpers
static void setStripColor(uint8_t startIdx, uint8_t count, uint8_t r, uint8_t g, uint8_t b) {
  for (uint16_t i = startIdx; i < startIdx + count && i < strip.numPixels(); i++) {
    strip.setPixelColor(i, strip.Color(r, g, b));
  }
}

static void showStop() {
  setStripColor(0, TOTAL_PIXELS, 255, 0, 0);
  strip.show();
}

void neoInit() {
  strip.begin();
  strip.setBrightness(60);
  showStop();
}

void neoLeft() {
  if (lastNeoState != "LEFT"){
  setStripColor(LEFT_START, LEFT_NEOPIXELS, 0, 255, 0);   // left green
  setStripColor(RIGHT_START, RIGHT_NEOPIXELS, 255, 255, 255); // right white
  strip.show();
  lastNeoState = "LEFT";
  }
}

void neoRight() {
  if (lastNeoState != "RIGHT"){
  setStripColor(RIGHT_START, RIGHT_NEOPIXELS, 0, 255, 0); // right green
  setStripColor(LEFT_START, LEFT_NEOPIXELS, 255, 255, 255);   // left white
  strip.show();
  lastNeoState = "RIGHT";
  }
}

void neoStraight() {
  if (lastNeoState != "STRAIGHT"){
  setStripColor(0, TOTAL_PIXELS, 255, 255, 255); // all white
  strip.show();
  lastNeoState = "STRAIGHT";
}
}

void neoStop() {
  if (lastNeoState != "STOP"){
  showStop();
  lastNeoState = "STOP";

}
